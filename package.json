{
  "name": "shopkart-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ShopKart MERN Application Workspace",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed || node backend/seed.js",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e"
  }
}
